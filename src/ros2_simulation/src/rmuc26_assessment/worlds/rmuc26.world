    <model name="astra_sensor_rig">
      <static>true</static>
      <pose>0 0.4 -0.1691496849 0 0 0</pose>
      <link name="rig">
        <sensor name="camera" type="camera">
          <pose>0 0 .41 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/assessment</namespace>
              <remapping>image_raw:=camera/image_raw</remapping>
              <remapping>camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>astra_camera_optical</frame_name>
          </plugin>
        </sensor>
        <sensor name="lidar" type="ray">
          <pose>0 0 .27 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-0.6143558967020041</min_angle>
                <max_angle>0.6143558967020041</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.05</min>
              <max>90</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>.003</stddev>
            </noise>
          </ray>
          <plugin name="lidar" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/assessment</namespace>
              <remapping>~/out:=lidar/scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>astra_lidar</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="astra_overview">
      <static>true</static>
      <link name="camera">
        <pose>10 2.624344 40 0 1.57079632679 0</pose>
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="overview" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/assessment/overview</namespace>
            </ros>
            <camera_name>overview</camera_name>
            <frame_name>astra_overview</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <gui>
      <camera name="user_camera">
        <pose>-18 -22 24 0 0.55 0.62</pose>
      </camera>
    </gui>
    <light name="assessment_sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <direction>-0.2 0.1 -1</direction>
    </light>
    <plugin name="assessment_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/assessment</namespace>
      </ros>
      <update_rate>30</update_rate>
    </plugin>
  </world>
</sdf>